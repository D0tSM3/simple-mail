# Copy to .env and fill in. Never commit .env.
APP_ENV=local
DEBUG_ERRORS=true
APP_URL=http://localhost:8080

GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

DB_HOST=127.0.0.1
DB_NAME=smart_mailbox
DB_USER=smart_mailbox_user
DB_PASS=replace-with-your-own-database-password

# Required: base64 encoding of exactly 32 random bytes. Keep only in this
# machine's .env or a secrets manager; losing it requires reconnecting Gmail.
TOKEN_ENC_KEY=replace-with-your-own-generated-value
